# Optional: enables LLM synthesis in report stage
OPENAI_API_KEY=

# Optional: OpenAI-compatible base URL (for compatible providers)
OPENAI_BASE_URL=

# Optional: model used when OPENAI_API_KEY is present
OPENAI_MODEL=gpt-4o-mini

# Optional: increases GitHub API rate limits
GITHUB_TOKEN=

# Optional: global HTTP timeout in seconds
HYPECHECK_TIMEOUT=20

# Optional: report output directory
HYPECHECK_REPORT_DIR=.hypecheck/reports
